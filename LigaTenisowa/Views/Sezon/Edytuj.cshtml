@model Sezon
@{
    ViewData["Title"] = "Edytuj sezon";
}

<h2>Edytuj sezon</h2>

<form method="post">
    <input asp-for="Id" type="hidden" />
    <div>
        <label>Nazwa:</label>
        <input asp-for="Nazwa" />
    </div>
    <div>
        <label>Data rozpoczęcia:</label>
        <input asp-for="DataRozpoczecia" type="date" />
    </div>
    <div>
        <label>Data zakończenia:</label>
        <input asp-for="DataZakonczenia" type="date" />
    </div>
    <div>
        <label>Aktywny:</label>
        <input asp-for="CzyAktywny" type="checkbox" />
    </div>
    <button type="submit">Zapisz</button>
    <a href="/Sezon">Anuluj</a>
</form>