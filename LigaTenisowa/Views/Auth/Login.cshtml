@{
    ViewData["Title"] = "Logowanie";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Logowanie - Liga Tenisowa</title>
</head>
<body>
    <h2>Liga Tenisowa - Logowanie</h2>

    @if (ViewBag.Error != null)
    {
        <p style="color:red">@ViewBag.Error</p>
    }

    <form method="post">
        <div>
            <label>Login:</label>
            <input type="text" name="login" required />
        </div>
        <div>
            <label>Hasło:</label>
            <input type="password" name="haslo" required />
        </div>
        <button type="submit">Zaloguj</button>
    </form>
</body>
</html>